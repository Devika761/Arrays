import java.util.Arrays;

class Main {
    public static void main(String[] args) {

        int[] arr = {7, 3, 2, 4, 9, 12, 56};
        int m = 3;

        Arrays.sort(arr);

        for (int s = 0; s <= arr.length - m; s++) {

            for (int i = s; i < s + m; i++) {
                System.out.print(arr[i] + " ");
            }

            System.out.println();
        }
    }
}

