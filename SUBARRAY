//SUBARRAY

/*{

Time Complexity: O(n³)
Space Complexity: O(1)

}*/

class Main {
    public static void main(String[] args) {

        int arr[] = {1, 2, 3};

        for (int start = 0; start < arr.length; start++) {

            for (int end = start; end < arr.length; end++) {

                System.out.print("[");

                for (int i = start; i <= end; i++) {
                    System.out.print(arr[i] + " ");
                }

                System.out.println("]");
            }
        }
    }
}
