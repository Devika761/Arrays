//OPTIMAL APPROACH

import java.util.Arrays;

class Main {
    static void nextPermutation(int[] nums) {
        int i = nums.length - 2;

        // Step 1: Find the pivot
        while (i >= 0 && nums[i] >= nums[i + 1]) {
            i--;
        }

        if (i >= 0) {
            // Step 2: Find the next greater element
            int j = nums.length - 1;

            while (nums[j] <= nums[i]) {
                j--;
            }

            // Step 3: Swap pivot and next greater element
            int temp = nums[i];
            nums[i] = nums[j];
            nums[j] = temp;
        }

        // Step 4: Reverse the suffix
        int left = i + 1;
        int right = nums.length - 1;

        while (left < right) {
            int temp = nums[left];
            nums[left] = nums[right];
            nums[right] = temp;

            left++;
            right--;
        }
    }

    public static void main(String[] args) {
        int[] nums = {1, 2, 3};

        nextPermutation(nums);

        System.out.println(Arrays.toString(nums));
    }
}


Approach	Time complexity	Extra space
Brute force + sorting	\(O(n! \times n^2)\)	\(O(n! \times n)\)
Generate + compare	\(O(n! \times n)\)	\(O(n! \times n)\)
Pivot + swap + reverse	\(O(n)\)	\(O(1)\)
