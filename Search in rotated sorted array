//TC:O(N)--LINEAR SEARCH
class tar{
    int findTar(int arr[],int t){
        for(int i=0;i<arr.length;i++){
            if(arr[i]==t){
                
                return i;//RETURN INDEX
            }
        }
        return -1;
    }
}
class Main {
    public static void main(String[] args) {
        int arr[]={4,5,6,7,0,1,2};
        int target=4;
        tar a=new tar();
       
        System.out.println( a.findTar(arr,target));
    }
}

