//BRUTE APPROACH-TC:(N^2)

class dupArr{
    boolean du(int arr[]){
            for(int i=0;i<arr.length;i++){
            for(int j=i+1;j<arr.length;j++){
                if(arr[i]==arr[j]){
                    return true;
                }
            }
        }
        return false;
    }
}
class Main {
    public static void main(String[] args) {
        System.out.println("Try clicking the Run button.");
        
        int []arr={1,2,3,1};
    dupArr a=new dupArr();
       System.out.println(a.du(arr)) ;
    }
}

